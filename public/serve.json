{
    "rewrites": [
        {
            "source": "/v:version/:asset",
            "destination": "/:asset"
        }
    ],
    "headers": [
        {
            "source": "**",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}